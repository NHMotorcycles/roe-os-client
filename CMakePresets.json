{
  "version": 6,
  "configurePresets": [
    {"name": "windows-release", "binaryDir": "${sourceDir}/build/${presetName}", "generator": "Visual Studio 17 2022", "architecture": "x64",
     "cacheVariables": {"CMAKE_POLICY_VERSION_MINIMUM": "3.5"},
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "linux-debug", "binaryDir": "${sourceDir}/build/${presetName}", "generator": "Ninja",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"}}
  ],
  "buildPresets": [
    {"name": "windows-release", "configurePreset": "windows-release", "configuration": "RelWithDebInfo"},
    {"name": "linux-debug", "configurePreset": "linux-debug"}
  ],
  "testPresets": [
    {"name": "windows-release", "configurePreset": "windows-release", "configuration": "RelWithDebInfo", "output": {"outputOnFailure": true}},
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}}
  ]
}
